APP_NAME=PharmaReg-XAI
APP_ENV=development
# Generate: python -c "import secrets; print(secrets.token_hex(48))"
SECRET_KEY=
# Omit DATABASE_URL for workspace-local SQLite; use PostgreSQL in Docker.
# DATABASE_URL=postgresql+psycopg://pharmareg:CHANGE_ME@localhost:5432/pharmareg
# Set REDIS_URL when Redis is available. SQL jobs remain durable without it.
REDIS_URL=
REDIS_REQUIRED=false
JOB_MODE=embedded
LLM_PROVIDER=local-extractive
ALLOW_EXTERNAL_LLM=false
OPENAI_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=240
LLM_JSON_SCHEMA=true
# Local inference: LLM_PROVIDER=local-openai, LLM_MODEL=llama3.2:3b
# OPENAI_BASE_URL=http://localhost:11434/v1
EMBEDDING_PROVIDER=hash-local
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
VECTOR_STORE=sql
CHROMA_MODE=http
MODELS_OFFLINE=false
EMBEDDING_BATCH_SIZE=32
CHUNK_SIZE=1200
CHUNK_OVERLAP=160
MAX_CHUNK_SIZE=4000
MAX_DOCUMENT_PAGES=1000
LLM_MAX_TOKENS=1600
CHROMA_HOST=localhost
CHROMA_PORT=8001
MAX_UPLOAD_SIZE_MB=50
OCR_ENABLED=true
# TESSDATA_PREFIX=/absolute/path/to/tessdata
# RERANKER_CACHE=/absolute/path/to/model/cache
# Optional antivirus executable + arguments, JSON array; filename appended automatically.
MALWARE_SCANNER_COMMAND=
REQUIRE_MALWARE_SCAN=false
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Independent secret for audit seals, or SECRET_KEY is used.
AUDIT_HMAC_KEY=
SOURCE_ALLOWED_HOSTS=
DEBUG=false

# MFA secrets are encrypted using SECRET_KEY; preserve it across restarts.
# OIDC requires an existing identity-provider application and explicit subject links.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_LABEL=Organization SSO
SIGNATURE_HMAC_KEY=
# Generate with secrets.token_hex(32). Keep this key outside backups of encrypted data.
ENCRYPT_STORAGE=false
STORAGE_ENCRYPTION_KEY=
TLS_CERT_FILE=
TLS_KEY_FILE=
API_RATE_LIMIT_PER_MINUTE=600
